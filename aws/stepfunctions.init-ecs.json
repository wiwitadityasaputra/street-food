{
  "StartAt": "vpc",
  "States": {
    "vpc": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeVpcs",
      "Arguments": {
        "Filters": [
          {
            "Name": "is-default",
            "Values": [
              "true"
            ]
          }
        ]
      },
      "Assign": {
        "VpcId": "{% $states.result.Vpcs[0].VpcId %}"
      },
      "Next": "subnets"
    },
    "subnets": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeSubnets",
      "Arguments": {
        "Filters": [
          {
            "Name": "vpc-id",
            "Values": [
              "{% $VpcId %}"
            ]
          }
        ]
      },
      "Assign": {
        "SubnetIds": "{% $states.result.Subnets.SubnetId %}",
        "LoadBalancerSecurityGroupName": "street-food-02-lb-security-group"
      },
      "Next": "loadbalancer - security groups - describe"
    },
    "loadbalancer - security groups - describe": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeSecurityGroups",
      "Arguments": {
        "Filters": [
          {
            "Name": "group-name",
            "Values": [
              "{% $LoadBalancerSecurityGroupName %}"
            ]
          },
          {
            "Name": "vpc-id",
            "Values": [
              "{% $VpcId %}"
            ]
          }
        ]
      },
      "Assign": {
        "LoadBalancerSecurityGroupId": "{% $states.result.SecurityGroups[0] ? $states.result.SecurityGroups[0].GroupId : null %}"
      },
      "Next": "loadbalancer - security groups - check"
    },
    "loadbalancer - security groups - check": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $LoadBalancerSecurityGroupId = null %}",
          "Next": "loadbalancer - security groups - create"
        }
      ],
      "Default": "paramter store - get"
    },
    "loadbalancer - security groups - create": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:createSecurityGroup",
      "Arguments": {
        "GroupName": "{% $LoadBalancerSecurityGroupName %}",
        "Description": "security group for lb",
        "VpcId": "{% $VpcId %}"
      },
      "Assign": {
        "LoadBalancerSecurityGroupId": "{% $states.result.GroupId %}"
      },
      "Next": "loadbalancer - authorize inbound traffict"
    },
    "loadbalancer - authorize inbound traffict": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:authorizeSecurityGroupIngress",
      "Arguments": {
        "GroupId": "{% $LoadBalancerSecurityGroupId %}",
        "IpPermissions": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "IpRanges": [
              {
                "CidrIp": "0.0.0.0/0",
                "Description": "Allow HTTP from anywhere"
              }
            ]
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "IpRanges": [
              {
                "CidrIp": "0.0.0.0/0",
                "Description": "Allow HTTPS from anywhere"
              }
            ]
          }
        ]
      },
      "Next": "paramter store - get"
    },
    "paramter store - get": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:getParameter",
      "Arguments": {
        "Name": "/street-food-02/prod/docker_image/latest",
        "WithDecryption": true
      },
      "Assign": {
        "DockerImageTag": "{% $states.result.Parameter.Value %}",
        "Random4Number": "{% $string($floor($random() * 90000) + 10000) %}"
      },
      "Next": "task definition - register"
    },
    "task definition - register": {
      "Type": "Task",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::aws-sdk:ecs:registerTaskDefinition",
      "Arguments": {
        "Family": "street-food-02-task-definition",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "Cpu": "512",
        "Memory": "1024",
        "TaskRoleArn": "arn:aws:iam::574434081764:role/street-food-02-task-definition-role",
        "ExecutionRoleArn": "arn:aws:iam::574434081764:role/street-food-02-task-definition-role",
        "ContainerDefinitions": [
          {
            "Name": "street-food-02-main-container",
            "Image": "{% '574434081764.dkr.ecr.us-east-1.amazonaws.com/street-food-02:' & $DockerImageTag %}",
            "Cpu": 0,
            "PortMappings": [
              {
                "ContainerPort": 3000,
                "HostPort": 3000,
                "Protocol": "tcp",
                "Name": "street-food-02-mapping-3000-tcp"
              }
            ],
            "Essential": true
          }
        ]
      },
      "Assign": {
        "ServiceName": "{% 'street-food-02-service-' & $DockerImageTag & '-' & $Random4Number %}",
        "ResourceId": "{% 'service/street-food-02-cluster/street-food-02-service-' & $DockerImageTag & '-' & $Random4Number %}",
        "TaskDefinitionArn": "{% $states.result.TaskDefinition.TaskDefinitionArn %}",
        "LoadBalancerName": "{% 'street-food-02-lb-' & $DockerImageTag %}"
      },
      "Next": "loadbalancer - describe"
    },
    "loadbalancer - describe": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:elasticloadbalancingv2:describeLoadBalancers",
      "Arguments": {
        "Names": [
          "street-food-02-lb"
        ]
      },
      "Catch": [
        {
          "ErrorEquals": [
            "ElasticLoadBalancingV2.LoadBalancerNotFoundException"
          ],
          "Next": "loadbalancer - create"
        }
      ],
      "Next": "target groups - blue - describe"
    },
    "loadbalancer - create": {
      "Type": "Task",
      "Arguments": {
        "Name": "street-food-02-loadbalancer",
        "Subnets": "{% $SubnetIds %}",
        "SecurityGroups": "{% [$LoadBalancerSecurityGroupId] %}",
        "Scheme": "internet-facing",
        "Type": "application"
      },
      "Resource": "arn:aws:states:::aws-sdk:elasticloadbalancingv2:createLoadBalancer",
      "Assign": {
        "LoadBalancerArn": "{% $states.result.LoadBalancers[0].LoadBalancerArn %}",
        "LoadBalancerDnsName": "{% $states.result.LoadBalancers[0].DnsName %}",
        "LoadBalancerHostedZoneId": "{% $states.result.LoadBalancers[0].CanonicalHostedZoneId %}"
      },
      "Next": "target groups - blue - describe"
    },

    "target groups - blue - describe": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:elasticloadbalancingv2:describeTargetGroups",
      "Arguments": {
        "Names": [
          "street-food-02-targetgroup-blue"
        ]
      },
      "Catch": [
        {
          "ErrorEquals": [
            "ElasticLoadBalancingV2.TargetGroupNotFoundException"
          ],
          "Next": "target groups - blue - create"
        }
      ],
      "Assign": {
        "TargetGroupBlueArn": "{% $states.result.TargetGroups[0].TargetGroupArn %}"
      },
      "Next": "target groups - green - describe"
    },
    "target groups - blue - create": {
      "Type": "Task",
      "Arguments": {
        "Name": "street-food-02-targetgroup-blue",
        "Protocol": "HTTP",
        "Port": 3000,
        "VpcId": "{% $VpcId %}",
        "TargetType": "ip"
      },
      "Resource": "arn:aws:states:::aws-sdk:elasticloadbalancingv2:createTargetGroup",
      "Assign": {
        "TargetGroupBlueArn": "{% $states.result.TargetGroups[0].TargetGroupArn %}"
      },
      "Next": "target groups - green - describe"
    },

    "target groups - green - describe": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:elasticloadbalancingv2:describeTargetGroups",
      "Arguments": {
        "Names": [
          "street-food-02-targetgroup-green"
        ]
      },
      "Catch": [
        {
          "ErrorEquals": [
            "ElasticLoadBalancingV2.TargetGroupNotFoundException"
          ],
          "Next": "target groups - green - create"
        }
      ],
      "Assign": {
        "TargetGroupGreenArn": "{% $states.result.TargetGroups[0].TargetGroupArn %}"
      },
      "Next": "loadbalancer - http listener - create"
    },
    "target groups - green - create": {
      "Type": "Task",
      "Arguments": {
        "Name": "street-food-02-targetgroup-green",
        "Protocol": "HTTP",
        "Port": 3000,
        "VpcId": "{% $VpcId %}",
        "TargetType": "ip"
      },
      "Resource": "arn:aws:states:::aws-sdk:elasticloadbalancingv2:createTargetGroup",
      "Assign": {
        "TargetGroupGreenArn": "{% $states.result.TargetGroups[0].TargetGroupArn %}"
      },
      "Next": "loadbalancer - http listener - create"
    },

    "loadbalancer - http listener - create": {
      "Type": "Task",
      "Arguments": {
        "LoadBalancerArn": "{% $LoadBalancerArn %}",
        "Protocol": "HTTP",
        "Port": 80,
        "DefaultActions": [
          {
            "Type": "redirect",
            "RedirectConfig": {
              "Protocol": "HTTPS",
              "Port": "443",
              "StatusCode": "HTTP_301"
            }
          }
        ]
      },
      "Resource": "arn:aws:states:::aws-sdk:elasticloadbalancingv2:createListener",
      "Next": "loadbalancer - https listener - create"
    },
    "loadbalancer - https listener - create": {
      "Type": "Task",
      "Arguments": {
        "LoadBalancerArn": "{% $LoadBalancerArn %}",
        "Protocol": "HTTPS",
        "Port": 443,
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "Certificates": [
          {
            "CertificateArn": "arn:aws:acm:us-east-1:574434081764:certificate/112a96a3-50c6-4beb-86eb-7fde2303e76a"
          }
        ],
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": "{% $TargetGroupBlueArn %}"
          }
        ]
      },
      "Resource": "arn:aws:states:::aws-sdk:elasticloadbalancingv2:createListener",
      "Assign": {
        "TaskDefinitionSecurityGroupName": "street-food-02-td-security-group"
      },
      "Next": "task definitions - security groups - describe"
    },

    "task definitions - security groups - describe": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeSecurityGroups",
      "Arguments": {
        "Filters": [
          {
            "Name": "group-name",
            "Values": [
              "{% $TaskDefinitionSecurityGroupName %}"
            ]
          },
          {
            "Name": "vpc-id",
            "Values": [
              "{% $VpcId %}"
            ]
          }
        ]
      },
      "Assign": {
        "TaskDefinitionSecurityGroupId": "{% $states.result.SecurityGroups[0] ? $states.result.SecurityGroups[0].GroupId : null %}"
      },
      "Next": "task definitions - security groups - check"
    },
    "task definitions - security groups - check": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $TaskDefinitionSecurityGroupId = null %}",
          "Next": "task definitions - security groups - create"
        }
      ],
      "Default": "service - create"
    },
    "task definitions - security groups - create": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:createSecurityGroup",
      "Arguments": {
        "GroupName": "{% $TaskDefinitionSecurityGroupName %}",
        "Description": "security group for lb",
        "VpcId": "{% $VpcId %}"
      },
      "Assign": {
        "TaskDefinitionSecurityGroupId": "{% $states.result.GroupId %}"
      },
      "Next": "task definitions - security groups - inbound traffict"
    },
    "task definitions - security groups - inbound traffict": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:authorizeSecurityGroupIngress",
      "Arguments": {
        "GroupId": "{% $TaskDefinitionSecurityGroupId %}",
        "IpPermissions": [
          {
            "IpProtocol": "tcp",
            "FromPort": 3000,
            "ToPort": 3000,
            "IpRanges": [
              {
                "CidrIp": "0.0.0.0/0",
                "Description": "Allow HTTP from anywhere"
              }
            ]
          }
        ]
      },
      "Next": "service - create"
    },

    "service - create": {
      "Type": "Task",
      "Arguments": {
        "TaskDefinition": "{% $TaskDefinitionArn %}",
        "ServiceName": "{% $ServiceName %}",
        "Cluster": "arn:aws:ecs:us-east-1:574434081764:cluster/street-food-02-cluster",
        "DesiredCount": 1,
        "LaunchType": "FARGATE",
        "AvailabilityZoneRebalancing": "ENABLED",
        "LoadBalancers": [
          {
            "TargetGroupArn": "{% $TargetGroupBlueArn %}",
            "ContainerName": "street-food-02-main-container",
            "ContainerPort": 3000
          }
        ],
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": "{% $SubnetIds %}",
            "SecurityGroups": "{% [$TaskDefinitionSecurityGroupId] %}",
            "AssignPublicIp": "ENABLED"
          }
        }
      },
      "Resource": "arn:aws:states:::aws-sdk:ecs:createService",
      "Next": "task definition - register auto scale"
    },
    "task definition - register auto scale": {
      "Type": "Task",
      "Arguments": {
        "ServiceNamespace": "ecs",
        "ResourceId": "{% $ResourceId %}",
        "ScalableDimension": "ecs:service:DesiredCount",
        "MinCapacity": 1,
        "MaxCapacity": 2
      },
      "Resource": "arn:aws:states:::aws-sdk:applicationautoscaling:registerScalableTarget",
      "Next": "task definition - put scaling policy"
    },
    "task definition - put scaling policy": {
      "Type": "Task",
      "Arguments": {
        "PolicyName": "street-food-02-app-cpu-scaling-policy",
        "ServiceNamespace": "ecs",
        "ResourceId": "{% $ResourceId %}",
        "ScalableDimension": "ecs:service:DesiredCount",
        "PolicyType": "TargetTrackingScaling",
        "TargetTrackingScalingPolicyConfiguration": {
          "TargetValue": 70,
          "PredefinedMetricSpecification": {
            "PredefinedMetricType": "ECSServiceAverageCPUUtilization"
          },
          "DisableScaleIn": true
        }
      },
      "Resource": "arn:aws:states:::aws-sdk:applicationautoscaling:putScalingPolicy",
      "Next": "route53 - upsert record"
    },

    "route53 - upsert record": {
      "Type": "Task",
      "Arguments": {
        "HostedZoneId": "Z0358711QMOX1SF1J2Q6",
        "ChangeBatch": {
          "Changes": [
            {
              "Action": "UPSERT",
              "ResourceRecordSet": {
                "Name": "sf-prod.wiwitadityasaputra.com",
                "Type": "A",
                "AliasTarget": {
                  "HostedZoneId": "{% $LoadBalancerHostedZoneId %}",
                  "DnsName": "{% $LoadBalancerDnsName %}",
                  "EvaluateTargetHealth": true
                }
              }
            }
          ]
        }
      },
      "Resource": "arn:aws:states:::aws-sdk:route53:changeResourceRecordSets",
      "Next": "Succeed"
    },
    
    "Succeed": {
      "Type": "Succeed"
    }
  },
  "QueryLanguage": "JSONata"
}
