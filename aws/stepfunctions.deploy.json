{
  "StartAt": "GetParameter",
  "States": {
    "GetParameter": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:getParameter",
      "Arguments": {
        "Name": "/STREET_FOOD/PROD/DOCKER_IMAGE/LATEST",
        "WithDecryption": true
      },
      "Output": {
        "DockerImageTag": "{% $states.result.Parameter.Value %}",
        "Random4Number": "{% $string($floor($random() * 90000) + 10000) %}"
      },
      "Next": "RegisterTaskDefinition"
    },
    "RegisterTaskDefinition": {
      "Type": "Task",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::aws-sdk:ecs:registerTaskDefinition",
      "Arguments": {
        "Family": "street-food-task-definition",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "Cpu": "512",
        "Memory": "1024",
        "TaskRoleArn": "arn:aws:iam::574434081764:role/ecsTaskExecutionRole",
        "ExecutionRoleArn": "arn:aws:iam::574434081764:role/ecsTaskExecutionRole",
        "ContainerDefinitions": [
          {
            "Name": "street-food-main-container",
            "Image": "{% '574434081764.dkr.ecr.us-east-1.amazonaws.com/street-food:' & $states.input.DockerImageTag %}",
            "Cpu": 0,
            "PortMappings": [
              {
                "ContainerPort": 3000,
                "HostPort": 3000,
                "Protocol": "tcp",
                "Name": "street-food-mapping-3000-tcp"
              }
            ],
            "Essential": true
          }
        ]
      },
      "Output": {
        "DockerImageTag": "{% $states.input.DockerImageTag %}",
        "ServiceName": "{% 'street-food-service-' & $states.input.DockerImageTag & '-' & $states.input.Random4Number %}",
        "ResourceId": "{% 'service/street-food-cluster/street-food-service-' & $states.input.DockerImageTag & '-' & $states.input.Random4Number %}",
        "TaskDefinitionArn": "{% $states.result.TaskDefinition.TaskDefinitionArn %}"
      },
      "Next": "CreateLoadBalancer"
    },
    "CreateLoadBalancer": {
      "Type": "Task",
      "Arguments": {
        "Name": "{% 'street-food-lb-' & $states.input.DockerImageTag %}",
        "Subnets": [
          "subnet-016f393f04de2d5f0",
          "subnet-02537832bcaa644ab",
          "subnet-06e69d7f7703f1ee0",
          "subnet-0e470e28d324a6190",
          "subnet-0abbddb77c1b9a936",
          "subnet-0ccfeefe8251d522c"
        ],
        "SecurityGroups": [
          "sg-0f4e77dcfc8f197de"
        ],
        "Scheme": "internet-facing",
        "Type": "application"
      },
      "Resource": "arn:aws:states:::aws-sdk:elasticloadbalancingv2:createLoadBalancer",
      "Output": {
        "DockerImageTag": "{% $states.input.DockerImageTag %}",
        "ServiceName": "{% $states.input.ServiceName %}",
        "ResourceId": "{% $states.input.ResourceId %}",
        "TaskDefinitionArn": "{% $states.input.TaskDefinitionArn %}",
        "LoadBalancerArn": "{% $states.result.LoadBalancers[0].LoadBalancerArn %}",
        "LoadBalancerDnsName": "{% $states.result.LoadBalancers[0].DnsName %}",
        "LoadBalancerHostedZoneId": "{% $states.result.LoadBalancers[0].CanonicalHostedZoneId %}"
      },
      "Next": "CreateTargetGroup"
    },
    "CreateTargetGroup": {
      "Type": "Task",
      "Arguments": {
        "Name": "{% 'street-food-tg-' & $states.input.DockerImageTag %}",
        "Protocol": "HTTP",
        "Port": 3000,
        "VpcId": "vpc-0047e9ff12e04f670",
        "TargetType": "ip"
      },
      "Resource": "arn:aws:states:::aws-sdk:elasticloadbalancingv2:createTargetGroup",
      "Output": {
        "DockerImageTag": "{% $states.input.DockerImageTag %}",
        "ServiceName": "{% $states.input.ServiceName %}",
        "ResourceId": "{% $states.input.ResourceId %}",
        "TaskDefinitionArn": "{% $states.input.TaskDefinitionArn %}",
        "LoadBalancerArn": "{% $states.input.LoadBalancerArn %}",
        "LoadBalancerDnsName": "{% $states.input.LoadBalancerDnsName %}",
        "LoadBalancerHostedZoneId": "{% $states.input.LoadBalancerHostedZoneId %}",
        "TargetGroupArn": "{% $states.result.TargetGroups[0].TargetGroupArn %}"
      },
      "Next": "CreateHttpListener"
    },
    "CreateHttpListener": {
      "Type": "Task",
      "Arguments": {
        "LoadBalancerArn": "{% $states.input.LoadBalancerArn %}",
        "Protocol": "HTTP",
        "Port": 80,
        "DefaultActions": [
          {
            "Type": "redirect",
            "RedirectConfig": {
              "Protocol": "HTTPS",
              "Port": "443",
              "StatusCode": "HTTP_301"
            }
          }
        ]
      },
      "Resource": "arn:aws:states:::aws-sdk:elasticloadbalancingv2:createListener",
      "Output": {
        "DockerImageTag": "{% $states.input.DockerImageTag %}",
        "ServiceName": "{% $states.input.ServiceName %}",
        "ResourceId": "{% $states.input.ResourceId %}",
        "TaskDefinitionArn": "{% $states.input.TaskDefinitionArn %}",
        "LoadBalancerArn": "{% $states.input.LoadBalancerArn %}",
        "LoadBalancerDnsName": "{% $states.input.LoadBalancerDnsName %}",
        "LoadBalancerHostedZoneId": "{% $states.input.LoadBalancerHostedZoneId %}",
        "TargetGroupArn": "{% $states.input.TargetGroupArn %}"
      },
      "Next": "CreateHttpsListener"
    },
    "CreateHttpsListener": {
      "Type": "Task",
      "Arguments": {
        "LoadBalancerArn": "{% $states.input.LoadBalancerArn %}",
        "Protocol": "HTTPS",
        "Port": 443,
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "Certificates": [
          {
            "CertificateArn": "arn:aws:acm:us-east-1:574434081764:certificate/112a96a3-50c6-4beb-86eb-7fde2303e76a"
          }
        ],
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": "{% $states.input.TargetGroupArn %}"
          }
        ]
      },
      "Resource": "arn:aws:states:::aws-sdk:elasticloadbalancingv2:createListener",
      "Output": {
        "DockerImageTag": "{% $states.input.DockerImageTag %}",
        "ServiceName": "{% $states.input.ServiceName %}",
        "ResourceId": "{% $states.input.ResourceId %}",
        "TaskDefinitionArn": "{% $states.input.TaskDefinitionArn %}",
        "LoadBalancerArn": "{% $states.input.LoadBalancerArn %}",
        "LoadBalancerDnsName": "{% $states.input.LoadBalancerDnsName %}",
        "LoadBalancerHostedZoneId": "{% $states.input.LoadBalancerHostedZoneId %}",
        "TargetGroupArn": "{% $states.input.TargetGroupArn %}"
      },
      "Next": "CreateService"
    },
    "CreateService": {
      "Type": "Task",
      "Arguments": {
        "TaskDefinition": "{% $states.input.TaskDefinitionArn %}",
        "ServiceName": "{% $states.input.ServiceName %}",
        "Cluster": "arn:aws:ecs:us-east-1:574434081764:cluster/street-food-cluster",
        "DesiredCount": 1,
        "LaunchType": "FARGATE",
        "AvailabilityZoneRebalancing": "ENABLED",
        "LoadBalancers": [
          {
            "TargetGroupArn": "{% $states.input.TargetGroupArn %}",
            "ContainerName": "street-food-main-container",
            "ContainerPort": 3000
          }
        ],
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": [
              "subnet-016f393f04de2d5f0",
              "subnet-02537832bcaa644ab",
              "subnet-06e69d7f7703f1ee0",
              "subnet-0e470e28d324a6190",
              "subnet-0abbddb77c1b9a936",
              "subnet-0ccfeefe8251d522c"
            ],
            "SecurityGroups": [
              "sg-0f4e77dcfc8f197de"
            ],
            "AssignPublicIp": "ENABLED"
          }
        }
      },
      "Resource": "arn:aws:states:::aws-sdk:ecs:createService",
      "Output": {
        "DockerImageTag": "{% $states.input.DockerImageTag %}",
        "ServiceName": "{% $states.input.ServiceName %}",
        "ResourceId": "{% $states.input.ResourceId %}",
        "TaskDefinitionArn": "{% $states.input.TaskDefinitionArn %}",
        "LoadBalancerArn": "{% $states.input.LoadBalancerArn %}",
        "LoadBalancerDnsName": "{% $states.input.LoadBalancerDnsName %}",
        "LoadBalancerHostedZoneId": "{% $states.input.LoadBalancerHostedZoneId %}",
        "TargetGroupArn": "{% $states.input.TargetGroupArn %}"
      },
      "Next": "RegisterScalableTarget"
    },
    "RegisterScalableTarget": {
      "Type": "Task",
      "Arguments": {
        "ServiceNamespace": "ecs",
        "ResourceId": "{% $states.input.ResourceId %}",
        "ScalableDimension": "ecs:service:DesiredCount",
        "MinCapacity": 1,
        "MaxCapacity": 2
      },
      "Resource": "arn:aws:states:::aws-sdk:applicationautoscaling:registerScalableTarget",
      "Output": {
        "DockerImageTag": "{% $states.input.DockerImageTag %}",
        "ServiceName": "{% $states.input.ServiceName %}",
        "ResourceId": "{% $states.input.ResourceId %}",
        "TaskDefinitionArn": "{% $states.input.TaskDefinitionArn %}",
        "LoadBalancerArn": "{% $states.input.LoadBalancerArn %}",
        "LoadBalancerDnsName": "{% $states.input.LoadBalancerDnsName %}",
        "LoadBalancerHostedZoneId": "{% $states.input.LoadBalancerHostedZoneId %}",
        "TargetGroupArn": "{% $states.input.TargetGroupArn %}"
      },
      "Next": "PutScalingPolicy"
    },
    "PutScalingPolicy": {
      "Type": "Task",
      "Arguments": {
        "PolicyName": "street-food-app-cpu-scaling-policy",
        "ServiceNamespace": "ecs",
        "ResourceId": "{% $states.input.ResourceId %}",
        "ScalableDimension": "ecs:service:DesiredCount",
        "PolicyType": "TargetTrackingScaling",
        "TargetTrackingScalingPolicyConfiguration": {
          "TargetValue": 70,
          "PredefinedMetricSpecification": {
            "PredefinedMetricType": "ECSServiceAverageCPUUtilization"
          },
          "DisableScaleIn": true
        }
      },
      "Resource": "arn:aws:states:::aws-sdk:applicationautoscaling:putScalingPolicy",
      "Output": {
        "DockerImageTag": "{% $states.input.DockerImageTag %}",
        "ServiceName": "{% $states.input.ServiceName %}",
        "ResourceId": "{% $states.input.ResourceId %}",
        "TaskDefinitionArn": "{% $states.input.TaskDefinitionArn %}",
        "LoadBalancerArn": "{% $states.input.LoadBalancerArn %}",
        "LoadBalancerDnsName": "{% $states.input.LoadBalancerDnsName %}",
        "LoadBalancerHostedZoneId": "{% $states.input.LoadBalancerHostedZoneId %}",
        "TargetGroupArn": "{% $states.input.TargetGroupArn %}"
      },
      "Next": "UpsertRoute53Record"
    },
    "UpsertRoute53Record": {
      "Type": "Task",
      "Arguments": {
        "HostedZoneId": "Z0358711QMOX1SF1J2Q6",
        "ChangeBatch": {
          "Changes": [
            {
              "Action": "UPSERT",
              "ResourceRecordSet": {
                "Name": "sf-prod.wiwitadityasaputra.com",
                "Type": "A",
                "AliasTarget": {
                  "HostedZoneId": "{% $states.input.LoadBalancerHostedZoneId %}",
                  "DnsName": "{% $states.input.LoadBalancerDnsName %}",
                  "EvaluateTargetHealth": true
                }
              }
            }
          ]
        }
      },
      "Resource": "arn:aws:states:::aws-sdk:route53:changeResourceRecordSets",
      "Output": {
        "DockerImageTag": "{% $states.input.DockerImageTag %}",
        "ServiceName": "{% $states.input.ServiceName %}",
        "ResourceId": "{% $states.input.ResourceId %}",
        "TaskDefinitionArn": "{% $states.input.TaskDefinitionArn %}",
        "LoadBalancerArn": "{% $states.input.LoadBalancerArn %}",
        "LoadBalancerDnsName": "{% $states.input.LoadBalancerDnsName %}",
        "LoadBalancerHostedZoneId": "{% $states.input.LoadBalancerHostedZoneId %}",
        "TargetGroupArn": "{% $states.input.TargetGroupArn %}"
      },
      "Next": "Succeed"
    },
    "Succeed": {
      "Type": "Succeed",
      "Output": {
        "DockerImageTag": "{% $states.input.DockerImageTag %}",
        "ServiceName": "{% $states.input.ServiceName %}",
        "ResourceId": "{% $states.input.ResourceId %}",
        "TaskDefinitionArn": "{% $states.input.TaskDefinitionArn %}",
        "LoadBalancerArn": "{% $states.input.LoadBalancerArn %}",
        "LoadBalancerDnsName": "{% $states.input.LoadBalancerDnsName %}",
        "LoadBalancerHostedZoneId": "{% $states.input.LoadBalancerHostedZoneId %}",
        "TargetGroupArn": "{% $states.input.TargetGroupArn %}"
      }
    }
  },
  "QueryLanguage": "JSONata"
}